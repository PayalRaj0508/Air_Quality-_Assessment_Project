    lay.yaxis.title = { text: LABEL[p] + ' (' + UNIT[p] + ')', font:{ size:11, color:'#93a6b8' } };
    Plotly.newPlot('vizTrend', traces, lay, { responsive: true });
  }

  /* ---- 4.2 seasonal box ---- */
  function drawSeason(){
    const p = $('vizSeasonPoll').value || 'pm25';
    const seasons = ['Winter','Summer','Monsoon','Post-Monsoon'];
    const traces = seasons.map(s => {
      const vals = data.filter(r => r.season === s && r[p]!==null && isFinite(r[p])).map(r=>r[p]);
      return { y: vals, type: 'box', name: s, boxmean: 'sd',
               marker: { color: '#38bdf8' }, line: { color: '#7dd3fc' } };
    });
    const lay = plotLayout(LABEL[p] + ' by season — Gujarat');
    lay.yaxis.title = { text: LABEL[p] + ' (' + UNIT[p] + ')', font:{ size:11, color:'#93a6b8' } };
    lay.showlegend = false;
    Plotly.newPlot('vizSeason', traces, lay, { responsive: true });
  }

  /* ---- 4.3 station ranking ---- */
  function drawRank(){
    const p = $('vizPollutant').value || 'pm25';
    const names = [], vals = [];
    for(const st of stations){
      const rows = data.filter(r=>r.station===st);
      const v = rows.map(r=>r[p]).filter(x=>x!==null && isFinite(x));
      names.push(st); vals.push(v.length ? mean(v) : 0);
    }
    const order = vals.map((v,i)=>[v,i]).sort((a,b)=>a[0]-b[0]);
    Plotly.newPlot('vizRank', [{
      x: order.map(o=>vals[o[1]]),
      y: order.map(o=>names[o[1]]),
      type: 'bar', orientation: 'h',
      marker: { color: order.map(o=>vals[o[1]]), colorscale: 'YlOrRd' },
      text: order.map(o=>fmt(vals[o[1]],1)),
      textposition: 'outside',
      textfont: { color: '#e6edf3', size: 11 }
    }], Object.assign(plotLayout('Mean ' + LABEL[p] + ' by station (ranked)'), {
      xaxis: { title: { text: LABEL[p] + ' (' + UNIT[p] + ')', font:{size:11,color:'#93a6b8'} }, gridcolor:'#22303f', color:'#93a6b8' },
      yaxis: { gridcolor:'#22303f', color:'#93a6b8' },
      margin: { l: 110, r: 60, t: 40, b: 50 }
    }), { responsive: true });
  }

  drawTrend(); drawSeason(); drawRank();

  $('vizPollutant').onchange = function(){ drawTrend(); drawRank(); };
  $('vizSeasonPoll').onchange = drawSeason;

  if(state.aqiDone) drawAqiCharts();
}

/* ==========================================================================
   TAB 5 : AQI MATHEMATICS
   ========================================================================== */
const BREAKPOINTS = {
  pm25: [[0,30,0,50],[30,60,50,100],[60,90,100,200],[90,120,200,300],[120,250,300,400],[250,500,400,500]],
  pm10: [[0,50,0,50],[50,100,50,100],[100,250,100,200],[250,350,200,300],[350,430,300,400],[430,600,400,500]],
  no2:  [[0,40,0,50],[40,80,50,100],[80,180,100,200],[180,280,200,300],[280,400,300,400],[400,600,400,500]],
  so2:  [[0,40,0,50],[40,80,50,100],[80,380,100,200],[380,800,200,300],[800,1600,300,400],[1600,2000,400,500]],
  co:   [[0,1,0,50],[1,2,50,100],[2,10,100,200],[10,17,200,300],[17,34,300,400],[34,50,400,500]],
  o3:   [[0,50,0,50],[50,100,50,100],[100,168,100,200],[168,208,200,300],[208,748,300,400],[748,1000,400,500]],
  nh3:  [[0,200,0,50],[200,400,50,100],[400,800,100,200],[800,1200,200,300],[1200,1800,300,400],[1800,2400,400,500]]
};

const AQI_CATS = [
  { name:'Good',        lo:0,   hi:50,  cls:'p-good'  },
  { name:'Satisfactory',lo:51,  hi:100, cls:'p-sat'   },
  { name:'Moderate',    lo:101, hi:200, cls:'p-mod'   },
  { name:'Poor',        lo:201, hi:300, cls:'p-poor'  },
  { name:'Very Poor',   lo:301, hi:400, cls:'p-vpoor' },
  { name:'Severe',      lo:401, hi:500, cls:'p-sev'   }
];

function subIndex(c, p){
  if(c === null || c === undefined || !isFinite(c)) return null;
  if(c < 0) c = 0;
  const bp = BREAKPOINTS[p];
  if(!bp) return null;
  for(let i=0;i<bp.length;i++){
    const bl = bp[i][0], bh = bp[i][1], il = bp[i][2], ih = bp[i][3];
    if(c >= bl && c <= bh){
      return Math.round(((ih - il)/(bh - bl)) * (c - bl) + il);
    }
  }
  return 500;
}

function aqiCategory(a){
  if(a === null || a === undefined || !isFinite(a)) return null;
  for(const c of AQI_CATS) if(a >= c.lo && a <= c.hi) return c.name;
  return a > 500 ? 'Severe' : null;
}

function aqiCategoryClass(name){
  const c = AQI_CATS.find(x => x.name === name);
  return c ? c.cls : '';
}

function computeRowAqi(row, opts){
  const subs = {};
  for(const p of POLLUTANTS){
    const v = row[p];
    if(v === null || v === undefined || !isFinite(v)) continue;
    const si = subIndex(v, p);
    if(si !== null) subs[p] = si;
  }
  const keys = Object.keys(subs);
  const hasPM = ('pm25' in subs) || ('pm10' in subs);

  if(opts.relaxed){
    if(!keys.length) return { aqi: null, primary: null, subs: subs };
  } else {
    if(keys.length < 3 || !hasPM) return { aqi: null, primary: null, subs: subs };
  }

  let primary = null, max = -Infinity;
  for(const k of keys){ if(subs[k] > max){ max = subs[k]; primary = k; } }
  return { aqi: max, primary: primary, subs: subs };
}

/* ---- render breakpoint table ---- */
