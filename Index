   ========================================================================== */
function refreshExport(){
  const data = state.clean;
  if(!data.length){ $('exportSummary').innerHTML = '<p style="color:#93a6b8">No processed data yet.</p>'; return; }

  let h = '<div class="kpis">' +
    '<div class="kpi"><div class="v">'+data.length.toLocaleString()+'</div><div class="l">Clean records</div></div>' +
    '<div class="kpi"><div class="v">'+[...new Set(data.map(r=>r.station))].length+'</div><div class="l">Stations</div></div>';

  if(state.aqiDone){
    const withAqi = data.filter(r=>r.aqi!==null && isFinite(r.aqi));
    const cats = {};
    for(const r of withAqi) cats[r.aqiCategory] = (cats[r.aqiCategory]||0)+1;
    let dominant = '—', dmax = -1;
    for(const k in cats) if(cats[k] > dmax){ dmax = cats[k]; dominant = k; }
    const prim = {};
    for(const r of withAqi) if(r.primaryPollutant) prim[r.primaryPollutant] = (prim[r.primaryPollutant]||0)+1;
    let primDom = '—', pmax = -1;
    for(const k in prim) if(prim[k] > pmax){ pmax = prim[k]; primDom = k; }
    const meanAqi = mean(withAqi.map(r=>r.aqi));

    h += '<div class="kpi"><div class="v">'+fmt(meanAqi,1)+'</div><div class="l">Mean AQI (all stations)</div></div>' +
         '<div class="kpi"><div class="v" style="font-size:16px">'+dominant+'</div><div class="l">Dominant AQI category</div></div>' +
         '<div class="kpi"><div class="v" style="font-size:16px">'+LABEL[primDom]+'</div><div class="l">Most frequent primary pollutant</div></div>';
  }
  h += '</div>';

  if(state.stationStats){
    h += '<h3>Station ranking by mean AQI</h3><div class="tbl-wrap"><table><thead><tr>' +
         '<th>Rank</th><th>Station</th><th>Mean AQI</th><th>Category</th><th>Max</th><th>% Very Poor/Severe</th></tr></thead><tbody>';
    state.stationStats.forEach((s, i)=>{
      const cat = aqiCategory(s.meanAqi);
      h += '<tr><td>'+(i+1)+'</td><td><b>'+s.station+'</b></td><td>'+fmt(s.meanAqi,1)+'</td>' +
           '<td><span class="pill '+aqiCategoryClass(cat)+'">'+cat+'</span></td>' +
           '<td>'+fmt(s.maxAqi,0)+'</td><td>'+fmt(s.exceedPct,1)+'%</td></tr>';
    });
    h += '</tbody></table></div>';
  }

  $('exportSummary').innerHTML = h;
}

function downloadCSV(filename, rows, columns){
  if(!rows.length){ alert('No data to export.'); return; }
  const lines = [columns.join(',')];
  for(const r of rows){
    lines.push(columns.map(c=>{
      let v = r[c];
      if(v instanceof Date) v = dateKey(v);
      if(v === null || v === undefined) return '';
      const s = String(v);
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g,'""') + '"' : s;
    }).join(','));
  }
  const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(()=> URL.revokeObjectURL(a.href), 2000);
}

