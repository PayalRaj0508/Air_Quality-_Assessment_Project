function renderTable(containerId, cols, rows, headerMap, cellClassFn){
  const el = $(containerId);
  if(!el) return;
  if(!rows.length){ el.innerHTML = '<p style="color:#93a6b8;padding:10px">No data.</p>'; return; }
  let h = '<table><thead><tr>';
  for(const c of cols) h += '<th>' + ((headerMap && headerMap[c]) || c) + '</th>';
  h += '</tr></thead><tbody>';
  for(const r of rows){
    h += '<tr>';
    for(const c of cols){
      let v = r[c];
      if(v instanceof Date) v = dateKey(v);
      if(v===null || v===undefined || v==='') v = '—';
      else if(typeof v === 'number') v = (Math.abs(v) >= 1000) ? v.toLocaleString() : (Math.round(v*100)/100);
      const cls = cellClassFn ? cellClassFn(c, r) : '';
      h += '<td' + (cls ? ' class="'+cls+'"' : '') + '>' + v + '</td>';
    }
    h += '</tr>';
  }
  h += '</tbody></table>';
  el.innerHTML = h;
}

function renderAudit(containerId, rows){
  const el = $(containerId);
  if(!rows.length){ el.innerHTML = '<p style="color:#93a6b8">No data loaded.</p>'; return; }

  let h = '<div class="tbl-wrap"><table><thead><tr>' +
    '<th>Column</th><th>Non-null</th><th>Null</th><th>Null %</th>' +
    '<th>Min</th><th>Q1</th><th>Median</th><th>Q3</th><th>Max</th><th>Mean</th><th>SD</th>' +
    '</tr></thead><tbody>';

  for(const p of POLLUTANTS){
    const vals = rows.map(r=>r[p]).filter(v => v!==null && v!==undefined && isFinite(v));
    vals.sort((a,b)=>a-b);
    const nulls = rows.length - vals.length;
    h += '<tr><td><b>' + LABEL[p] + '</b></td>' +
         '<td>' + vals.length.toLocaleString() + '</td>' +
         '<td>' + nulls.toLocaleString() + '</td>' +
         '<td>' + (rows.length ? (nulls/rows.length*100).toFixed(2) : 0) + '%</td>' +
         '<td>' + fmt(vals[0]) + '</td>' +
         '<td>' + fmt(quantile(vals,0.25)) + '</td>' +
         '<td>' + fmt(quantile(vals,0.5)) + '</td>' +
         '<td>' + fmt(quantile(vals,0.75)) + '</td>' +
         '<td>' + fmt(vals[vals.length-1]) + '</td>' +
         '<td>' + fmt(mean(vals)) + '</td>' +
         '<td>' + fmt(std(vals)) + '</td></tr>';
  }
  h += '</tbody></table></div>';

  // duplicates
  const seen = new Set(); let dups = 0;
  for(const r of rows){
    const k = r.station + '|' + dateKey(r.date);
    if(seen.has(k)) dups++; else seen.add(k);
  }
  const badDates = rows.filter(r => !(r.date instanceof Date) || isNaN(r.date)).length;

  h += '<div class="kpis" style="margin-top:14px">' +
    '<div class="kpi"><div class="v">' + dups.toLocaleString() + '</div><div class="l">Duplicate (station+date)</div></div>' +
    '<div class="kpi"><div class="v">' + badDates + '</div><div class="l">Invalid dates</div></div>' +
    '<div class="kpi"><div class="v">' + [...new Set(rows.map(r=>r.station))].length + '</div><div class="l">Distinct stations</div></div>' +
    '</div>';

  el.innerHTML = h;
}

/* ==========================================================================
   TAB 2 : CLEANING PIPELINE
   ========================================================================== */
function cleanPipeline(){
  clearLog('log-pre');
  if(!state.raw.length){ logTo('log-pre','✗ No data loaded. Go to Tab 1 first.','err'); return; }

  const opts = {
    missing: $('optMissing').value,
    outlier: $('optOutlier').value,
    dedupe:  $('optDedupe').value === 'yes'
  };
  logTo('log-pre', '▶ Starting cleaning pipeline — missing="'+opts.missing+'", outlier="'+opts.outlier+'", dedupe='+opts.dedupe, 'info');

  let data = state.raw.map(r => Object.assign({}, r));
  const n0 = data.length;

  /* --- 2.2.1 date & station integrity --- */
  data = data.filter(r => r.date instanceof Date && !isNaN(r.date));
  logTo('log-pre', '① Date coercion: dropped ' + (n0 - data.length) + ' rows with unparseable dates.', 'ok');
  const n1 = data.length;
  data = data.filter(r => r.station && String(r.station).trim() !== '');
  logTo('log-pre', '② Station integrity: dropped ' + (n1 - data.length) + ' rows without a station label.', 'ok');

  /* --- 2.2.2 numeric coercion --- */
  let coerced = 0;
  for(const r of data){
    for(const p of POLLUTANTS){
      if(r[p] !== null && r[p] !== undefined){
        const v = toNum(r[p]);
        if(v === null){ r[p] = null; coerced++; }
        else if(v < 0){ r[p] = null; coerced++; }   // negative concentrations impossible
        else r[p] = v;
      }
    }
  }
  logTo('log-pre', '③ Numeric coercion: ' + coerced + ' non-numeric / negative values set to null.', 'ok');

  /* --- 2.2.3 duplicates --- */
  if(opts.dedupe){
    const seen = new Set(); const out = [];
    for(const r of data){
      const k = r.station + '|' + dateKey(r.date);
      if(seen.has(k)) continue;
      seen.add(k);
      out.push(r);
    }
    logTo('log-pre', '④ Deduplication: removed ' + (data.length - out.length) + ' duplicate (station+date) records.', 'ok');
    data = out;
  }

  /* --- sort by station then date --- */
  data.sort((a,b) => a.station.localeCompare(b.station) || (a.date - b.date));
  logTo('log-pre', '⑤ Sorted by station → date ascending.', 'ok');

  /* --- 2.2.4 missing value handling --- */
  const beforeMissing = countMissing(data);
  logTo('log-pre', '⑥ Missing values before imputation: ' + beforeMissing.toLocaleString() +
        ' (' + (beforeMissing/(data.length*POLLUTANTS.length)*100).toFixed(2) + '%).', 'info');

  if(opts.missing === 'drop'){
    const keep = data.filter(r => POLLUTANTS.every(p => r[p] !== null && isFinite(r[p])));
    logTo('log-pre', '   → Dropped ' + (data.length - keep.length) + ' rows with any missing pollutant.', 'ok');
    data = keep;
  } else if(opts.missing === 'ffill'){
    forwardBackwardFill(data, 3);
    logTo('log-pre', '   → Forward/backward fill applied, max run = 3 days per station.', 'ok');
  } else if(opts.missing === 'linear'){
    linearInterpolate(data);
    logTo('log-pre', '   → Linear interpolation by calendar-day distance within each station.', 'ok');
  } else if(opts.missing === 'seasonal'){
    seasonalMeanFill(data);
    logTo('log-pre', '   → Seasonal (station × month) mean imputation applied.', 'ok');
  } else if(opts.missing === 'knn'){
    const filled = knnImpute(data, 11);
    logTo('log-pre', '   → KNN imputation (k=11, z-scored Euclidean on available pollutants) filled ' +
          filled.toLocaleString() + ' cells.', 'ok');
  }

  /* --- residual fallback --- */
  const resid = residualFill(data);
  if(resid) logTo('log-pre', '⑦ Residual fallback (station-month mean → station mean → global mean): ' +
                    resid.toLocaleString() + ' cells filled.', 'warn');

  /* --- 2.2.5 outlier treatment --- */
  if(opts.outlier === 'iqr'){
    const capped = iqrCap(data);
    logTo('log-pre', '⑧ IQR Winsorization (1.5×IQR, station-wise): ' + capped.toLocaleString() +
          ' cells clipped to physically plausible bounds.', 'ok');
  } else if(opts.outlier === 'zscore'){
    const capped = zCap(data, 3);
    logTo('log-pre', '⑧ Z-score capping (|z|>3): ' + capped.toLocaleString() + ' cells clipped.', 'ok');
  } else {
    logTo('log-pre', '⑧ Outlier treatment skipped (option = none).', 'warn');
  }

  /* --- 2.2.6 feature engineering --- */
  for(const r of data){
    r.year       = r.date.getFullYear();
    r.month      = r.date.getMonth()+1;
    r.dayOfWeek  = r.date.getDay();
    r.season     = seasonOf(r.month);
    r.pmRatio    = (r.pm10 && r.pm10 > 0 && r.pm25 !== null) ? r.pm25 / r.pm10 : null;
  }
  logTo('log-pre', '⑨ Feature engineering: year, month, dayOfWeek, season, PM2.5/PM10 ratio.', 'ok');

  state.clean = data;
  const afterMissing = countMissing(data);
  logTo('log-pre', '✔ Pipeline complete. ' + data.length.toLocaleString() + ' clean records, ' +
        afterMissing + ' remaining nulls.', afterMissing === 0 ? 'ok' : 'warn');

  renderAudit('auditAfter', data);
  populateVizSelectors();
  buildEdA();
}

function countMissing(rows){
  let c = 0;
  for(const r of rows) for(const p of POLLUTANTS) if(r[p]===null || r[p]===undefined || !isFinite(r[p])) c++;
  return c;
}

/* ---- Imputation methods ---- */
function forwardBackwardFill(data, limit){
  for(const st in groupBy(data, r=>r.station)){
    const rows = data.filter(r=>r.station===st);
    for(const p of POLLUTANTS){
      let last = null, run = 0;
      for(const r of rows){
        if(r[p] !== null && isFinite(r[p])){ last = r[p]; run = 0; }
        else if(last !== null && run < limit){ r[p] = last; run++; }
        else { run++; }
      }
      // backward pass
      last = null; run = 0;
      for(let i=rows.length-1;i>=0;i--){
        const r = rows[i];
        if(r[p] !== null && isFinite(r[p])){ last = r[p]; run = 0; }
        else if(last !== null && run < limit){ r[p] = last; run++; }
        else { run++; }
      }
    }
  }
}

function linearInterpolate(data){
  const DAY = 86400000;
  for(const st in groupBy(data, r=>r.station)){
    const rows = data.filter(r=>r.station===st);
    for(const p of POLLUTANTS){
      let i = 0;
      while(i < rows.length){
        if(rows[i][p] !== null && isFinite(rows[i][p])){ i++; continue; }
        // find run of nulls
        let j = i;
        while(j < rows.length && (rows[j][p] === null || !isFinite(rows[j][p]))) j++;
        const prev = i > 0 ? rows[i-1] : null;
        const next = j < rows.length ? rows[j] : null;
        if(prev && next){
          const t0 = prev.date.getTime(), t1 = next.date.getTime();
          const v0 = prev[p], v1 = next[p];
          for(let k=i;k<j;k++){
            const t = rows[k].date.getTime();
            const w = (t1 - t0) === 0 ? 0 : (t - t0)/(t1 - t0);
            rows[k][p] = v0 + w*(v1 - v0);
          }
        } else if(prev){
          for(let k=i;k<j;k++) rows[k][p] = prev[p];
        } else if(next){
          for(let k=i;k<j;k++) rows[k][p] = next[p];
        }
        i = j;
      }
    }
  }
}

function seasonalMeanFill(data){
  const groups = groupBy(data, r => r.station + '#' + r.date.getMonth());
  const means = {};
  for(const k in groups){
    const rows = groups[k];
    for(const p of POLLUTANTS){
      const vals = rows.map(r=>r[p]).filter(v => v!==null && isFinite(v));
      means[k + '#' + p] = vals.length ? mean(vals) : null;
    }
  }
  for(const r of data){
    const k = r.station + '#' + r.date.getMonth();
    for(const p of POLLUTANTS){
      if(r[p] === null || !isFinite(r[p])){
        const m = means[k + '#' + p];
        if(m !== null) r[p] = m;
      }
    }
  }
}

function knnImpute(data, k){
  let totalFilled = 0;
  const byStation = groupBy(data, r => r.station);

  for(const st in byStation){
    const rows = byStation[st];

    // complete rows = rows with all pollutants present
    let complete = rows.filter(r => POLLUTANTS.every(p => r[p] !== null && isFinite(r[p])));
    if(complete.length < k) continue;
    if(complete.length > 700){
      complete = complete.slice().sort(()=>Math.random()-0.5).slice(0,700);
    }

    // z-score stats from complete rows
    const stats = {};
    for(const p of POLLUTANTS){
      const vals = complete.map(r => r[p]);
      const m = mean(vals);
      const s = std(vals) || 1;
      stats[p] = { m: m, s: s };
    }

    // build z-scored matrix
    const mat = complete.map(r => POLLUTANTS.map(p => (r[p] - stats[p].m) / stats[p].s));

    const incomplete = rows.filter(r => POLLUTANTS.some(p => r[p] === null || !isFinite(r[p])));

    for(const r of incomplete){
      const avail = POLLUTANTS.filter(p => r[p] !== null && isFinite(r[p]));
      if(!avail.length) continue;
      const q = avail.map(p => (r[p] - stats[p].m) / stats[p].s);
      const availIdx = avail.map(p => POLLUTANTS.indexOf(p));

      const dists = new Array(mat.length);
      for(let i=0;i<mat.length;i++){
        let d = 0;
        const row = mat[i];
        for(let j=0;j<availIdx.length;j++){
          const diff = row[availIdx[j]] - q[j];
          d += diff*diff;
        }
        dists[i] = Math.sqrt(d);
      }

      const pairs = dists.map((d,i)=>[d,i]).sort((a,b)=>a[0]-b[0]).slice(0,k);
      let wsum = 0;
      for(const pr of pairs) wsum += 1/(pr[0] + 1e-6);

      for(const p of POLLUTANTS){
        if(r[p] === null || !isFinite(r[p])){
          let v = 0;
          for(const pr of pairs){
            const w = 1/(pr[0] + 1e-6);
            v += w * complete[pr[1]][p];
          }
          r[p] = v / wsum;
          totalFilled++;
        }
      }
    }
  }
  return totalFilled;
}

function residualFill(data){
  let filled = 0;
  // station-month mean
  const smGroups = groupBy(data, r => r.station + '#' + r.date.getMonth());
  const smMeans = {};
  for(const k in smGroups){
    for(const p of POLLUTANTS){
      const vals = smGroups[k].map(r=>r[p]).filter(v=>v!==null && isFinite(v));
      smMeans[k+'#'+p] = vals.length ? mean(vals) : null;
    }
  }
  for(const r of data){
    const k = r.station + '#' + r.date.getMonth();
    for(const p of POLLUTANTS){
      if(r[p]===null || !isFinite(r[p])){
        const m = smMeans[k+'#'+p];
        if(m !== null){ r[p] = m; filled++; }
      }
    }
  }
  // station mean
  const stGroups = groupBy(data, r => r.station);
  const stMeans = {};
  for(const k in stGroups){
    for(const p of POLLUTANTS){
      const vals = stGroups[k].map(r=>r[p]).filter(v=>v!==null && isFinite(v));
      stMeans[k+'#'+p] = vals.length ? mean(vals) : null;
    }
  }
  for(const r of data){
    for(const p of POLLUTANTS){
      if(r[p]===null || !isFinite(r[p])){
        const m = stMeans[r.station+'#'+p];
        if(m !== null){ r[p] = m; filled++; }
      }
    }
  }
  // global mean
  for(const p of POLLUTANTS){
    const vals = data.map(r=>r[p]).filter(v=>v!==null && isFinite(v));
    const g = vals.length ? mean(vals) : 0;
    for(const r of data){
      if(r[p]===null || !isFinite(r[p])){ r[p] = g; filled++; }
    }
  }
  return filled;
}

function iqrCap(data){
  let capped = 0;
  const byStation = groupBy(data, r => r.station);
  for(const st in byStation){
    const rows = byStation[st];
    for(const p of POLLUTANTS){
      const vals = rows.map(r=>r[p]).filter(v=>v!==null && isFinite(v)).sort((a,b)=>a-b);
      if(vals.length < 8) continue;
      const q1 = quantile(vals, 0.25), q3 = quantile(vals, 0.75);
      const iqr = q3 - q1;
      const lo = Math.max(0, q1 - 1.5*iqr);
      const hi = q3 + 1.5*iqr;
      for(const r of rows){
        if(r[p] === null || !isFinite(r[p])) continue;
        if(r[p] < lo){ r[p] = lo; capped++; }
        else if(r[p] > hi){ r[p] = hi; capped++; }
      }
    }
  }
  return capped;
}

function zCap(data, z){
  let capped = 0;
  const byStation = groupBy(data, r => r.station);
  for(const st in byStation){
    const rows = byStation[st];
    for(const p of POLLUTANTS){
      const vals = rows.map(r=>r[p]).filter(v=>v!==null && isFinite(v));
      if(vals.length < 8) continue;
      const m = mean(vals), s = std(vals);
      if(!s) continue;
      const lo = Math.max(0, m - z*s), hi = m + z*s;
      for(const r of rows){
        if(r[p] === null || !isFinite(r[p])) continue;
        if(r[p] < lo){ r[p] = lo; capped++; }
        else if(r[p] > hi){ r[p] = hi; capped++; }
      }
    }
  }
  return capped;
}

/* ==========================================================================
   TAB 3 : EDA
   ========================================================================== */
function buildEdA(){
  const data = state.clean;
  if(!data.length) return;

  /* ---- descriptive statistics ---- */
  let h = '<div class="tbl-wrap"><table><thead><tr><th>Pollutant</th><th>Unit</th><th>N</th>' +
          '<th>Mean</th><th>SD</th><th>Min</th><th>Q1</th><th>Median</th><th>Q3</th><th>Max</th>' +
          '<th>Skew</th><th>Kurtosis</th></tr></thead><tbody>';
  for(const p of POLLUTANTS){
    const v = data.map(r=>r[p]).filter(x=>x!==null && isFinite(x)).sort((a,b)=>a-b);
    const m = mean(v), s = std(v);
    let skew = 0, kurt = 0;
    if(s > 0 && v.length > 3){
      let s3 = 0, s4 = 0;
      for(const x of v){ const d = (x-m)/s; s3 += d*d*d; s4 += d*d*d*d; }
      skew = s3/v.length;
      kurt = s4/v.length - 3;
    }
    h += '<tr><td><b>'+LABEL[p]+'</b></td><td>'+UNIT[p]+'</td><td>'+v.length+'</td>' +
         '<td>'+fmt(m)+'</td><td>'+fmt(s)+'</td><td>'+fmt(v[0])+'</td>' +
         '<td>'+fmt(quantile(v,0.25))+'</td><td>'+fmt(quantile(v,0.5))+'</td>' +
         '<td>'+fmt(quantile(v,0.75))+'</td><td>'+fmt(v[v.length-1])+'</td>' +
         '<td>'+fmt(skew)+'</td><td>'+fmt(kurt)+'</td></tr>';
  }
  h += '</tbody></table></div>';
  $('edaStats').innerHTML = h;

  /* ---- correlation ---- */
  const matrix = [];
  for(const a of POLLUTANTS){
    const row = [];
    for(const b of POLLUTANTS){
      const x = [], y = [];
      for(const r of data){
        if(r[a]!==null && r[b]!==null && isFinite(r[a]) && isFinite(r[b])){ x.push(r[a]); y.push(r[b]); }
      }
      row.push(pearson(x,y));
    }
    matrix.push(row);
  }

  let ch = '<div class="tbl-wrap"><table><thead><tr><th>—</th>';
  for(const p of POLLUTANTS) ch += '<th>'+LABEL[p]+'</th>';
  ch += '</tr></thead><tbody>';
  for(let i=0;i<POLLUTANTS.length;i++){
    ch += '<tr><td><b>'+LABEL[POLLUTANTS[i]]+'</b></td>';
    for(let j=0;j<POLLUTANTS.length;j++){
      const v = matrix[i][j];
      const col = isNaN(v) ? '#93a6b8' : (v > 0.5 ? '#4ade80' : (v < -0.3 ? '#f87171' : '#e6edf3'));
      ch += '<td style="color:'+col+'">'+fmt(v,3)+'</td>';
    }
    ch += '</tr>';
  }
  ch += '</tbody></table></div>';
  $('edaCorrTbl').innerHTML = ch;

  Plotly.newPlot('edaCorrHeat', [{
    z: matrix,
    x: POLLUTANTS.map(p=>LABEL[p]),
    y: POLLUTANTS.map(p=>LABEL[p]),
    type: 'heatmap',
    colorscale: 'RdBu',
    zmid: 0, zmin: -1, zmax: 1,
    text: matrix.map(row => row.map(v => fmt(v,2))),
    texttemplate: '%{text}',
    textfont: { size: 11, color: '#0b1a24' },
    colorbar: { tickfont: { color: '#93a6b8' } }
  }], plotLayout('Pollutant Correlation Matrix'));

  /* ---- distributions ---- */
  const grid = $('edaDists');
  grid.innerHTML = '';
  for(const p of POLLUTANTS){
    const div = document.createElement('div');
    div.className = 'chart';
    div.id = 'dist-' + p;
    div.style.height = '260px';
    grid.appendChild(div);
    const vals = data.map(r=>r[p]).filter(v=>v!==null && isFinite(v));
    Plotly.newPlot(div.id, [{
      x: vals, type: 'histogram', nbinsx: 45,
      marker: { color: '#38bdf8', line: { color: '#0b1a24', width: 0.4 } },
      opacity: 0.9, name: LABEL[p]
    }], Object.assign(plotLayout(LABEL[p] + ' distribution'), {
      height: 260, margin: { l: 45, r: 12, t: 34, b: 38 },
      showlegend: false,
      xaxis: { title: { text: UNIT[p], font:{size:10, color:'#93a6b8'} }, color:'#93a6b8', gridcolor:'#22303f' },
      yaxis: { title: { text: 'Count', font:{size:10, color:'#93a6b8'} }, color:'#93a6b8', gridcolor:'#22303f' }
    }));
  }

  /* ---- station profile heatmap ---- */
  const stations = [...new Set(data.map(r=>r.station))].sort();
  const zRaw = stations.map(st=>{
    const rows = data.filter(r=>r.station===st);
    return POLLUTANTS.map(p=>{
      const vals = rows.map(r=>r[p]).filter(v=>v!==null && isFinite(v));
      return vals.length ? mean(vals) : 0;
    });
  });
  // normalise per pollutant column
  const zNorm = zRaw.map(row => row.slice());
  for(let j=0;j<POLLUTANTS.length;j++){
    let mn = Infinity, mx = -Infinity;
    for(let i=0;i<stations.length;i++){ mn = Math.min(mn, zRaw[i][j]); mx = Math.max(mx, zRaw[i][j]); }
    for(let i=0;i<stations.length;i++){
      zNorm[i][j] = (mx - mn) === 0 ? 0 : (zRaw[i][j] - mn)/(mx - mn);
    }
  }

  Plotly.newPlot('edaStationHeat', [{
    z: zNorm,
    x: POLLUTANTS.map(p=>LABEL[p]),
    y: stations,
    type: 'heatmap',
    colorscale: 'YlOrRd',
    zmin: 0, zmax: 1,
    text: zRaw.map(row => row.map(v => fmt(v,1))),
    texttemplate: '%{text}',
    textfont: { size: 11 },
    colorbar: { tickfont: { color: '#93a6b8' }, title: { text: 'norm.', font: { color:'#93a6b8', size:10 } } }
  }], plotLayout('Station × Pollutant Profile (labels = actual means)'));
}

