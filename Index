<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Gujarat Air Quality Analysis — CPCB AQI Pipeline</title>
<script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<style>
  :root{
    --bg:#0e1620; --panel:#152232; --panel2:#1b2b3d; --line:#29394c;
    --text:#e6edf3; --muted:#93a6b8; --accent:#38bdf8; --ok:#22c55e;
    --warn:#f59e0b; --bad:#ef4444; --purple:#a78bfa;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
       background:var(--bg);color:var(--text);font-size:13.5px;line-height:1.5}
  header{padding:16px 24px;background:linear-gradient(90deg,#08202e,#12405a);
         border-bottom:1px solid var(--line)}
  header h1{margin:0;font-size:19px;letter-spacing:.2px}
  header p{margin:4px 0 0;color:#a9c4d6;font-size:12px}
  nav{display:flex;flex-wrap:wrap;gap:6px;padding:10px 24px;background:var(--panel);
      border-bottom:1px solid var(--line);position:sticky;top:0;z-index:99}
  nav button{background:transparent;border:1px solid var(--line);color:var(--muted);
      padding:7px 14px;border-radius:8px;cursor:pointer;font-size:12.5px;font-weight:600}
  nav button:hover{color:var(--text);border-color:#3d5470}
  nav button.active{background:var(--accent);color:#04212f;border-color:var(--accent)}
  main{padding:18px 24px 80px;max-width:1500px;margin:0 auto}
  section.tab{display:none}
  section.tab.active{display:block}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:12px;
        padding:16px 18px;margin-bottom:16px}
  .card h2{margin:0 0 4px;font-size:15px;color:var(--accent)}
  .card h3{margin:14px 0 6px;font-size:13px;color:#bcd3e4;text-transform:uppercase;
        letter-spacing:.6px;font-weight:700}
  .card .hint{color:var(--muted);font-size:12px;margin:2px 0 12px}
  .row{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end}
  .field{display:flex;flex-direction:column;gap:4px}
  .field label{font-size:11.5px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px}
  select,input[type=number],input[type=text],input[type=file]{
      background:var(--panel2);border:1px solid var(--line);color:var(--text);
      padding:7px 10px;border-radius:7px;font-size:12.5px;min-width:130px}
  input[type=file]{padding:5px}
  button.btn{background:var(--accent);color:#04212f;border:none;padding:9px 18px;
      border-radius:8px;font-weight:700;cursor:pointer;font-size:12.5px}
  button.btn:hover{filter:brightness(1.1)}
  button.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}
  button.btn.green{background:var(--ok);color:#04210f}
  button.btn.amber{background:var(--warn);color:#2a1a00}
  button.btn:disabled{opacity:.45;cursor:not-allowed}
  .log{background:#0a121b;border:1px solid var(--line);border-radius:8px;padding:10px 12px;
       max-height:260px;overflow:auto;font-family:ui-monospace,Consolas,monospace;
       font-size:11.8px;margin-top:10px}
  .log div{padding:1px 0}
  .log-info{color:#9fd0e8}
  .log-ok{color:#5ee38a}
  .log-warn{color:#fbbf24}
  .log-err{color:#f87171}
  table{border-collapse:collapse;width:100%;font-size:12px;margin-top:8px}
  th,td{border:1px solid var(--line);padding:6px 9px;text-align:right;white-space:nowrap}
  th{background:var(--panel2);color:#bcd3e4;font-weight:700;text-align:center;
     position:sticky;top:0}
  td:first-child,th:first-child{text-align:left}
  .tbl-wrap{max-height:420px;overflow:auto;border-radius:8px;border:1px solid var(--line)}
  .tbl-wrap table{margin:0;border:none}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px}
  .chart{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:6px}
  .pill{display:inline-block;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700}
  .p-good{background:#00b05033;color:#4ade80;border:1px solid #4ade8055}
  .p-sat{background:#92d05033;color:#a3e635;border:1px solid #a3e63555}
  .p-mod{background:#ffff0033;color:#fde047;border:1px solid #fde04755}
  .p-poor{background:#ff990033;color:#fb923c;border:1px solid #fb923c55}
  .p-vpoor{background:#ff000033;color:#f87171;border:1px solid #f8717155}
  .p-sev{background:#c0000033;color:#ef4444;border:1px solid #ef444455}
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:10px 0}
  .kpi{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:12px 14px}
  .kpi .v{font-size:22px;font-weight:800;color:var(--accent)}
  .kpi .l{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
  .badge{background:var(--panel2);border:1px solid var(--line);padding:3px 9px;
      border-radius:6px;font-size:11px;color:var(--muted)}
  .flexbetween{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
  code{background:#0a121b;padding:1px 6px;border-radius:5px;color:#7dd3fc;font-size:12px}
  .note{background:#0a121b;border-left:3px solid var(--accent);padding:8px 12px;
        border-radius:6px;font-size:12px;color:#a9c4d6;margin:10px 0}
  ::-webkit-scrollbar{width:10px;height:10px}
  ::-webkit-scrollbar-track{background:#0a121b}
  ::-webkit-scrollbar-thumb{background:#2d4257;border-radius:6px}
</style>
</head>
<body>

<header>
  <h1>🏭 Gujarat Air Quality Analysis — CPCB AQI Pipeline</h1>
  <p>Load → Clean → Impute → Outlier treatment → EDA → Visualise → CPCB AQI math → Export. Runs fully offline in your browser.</p>
</header>

<nav id="nav">
  <button data-tab="load" class="active">1 · Data Load</button>
  <button data-tab="pre">2 · Preprocessing</button>
  <button data-tab="eda">3 · EDA</button>
  <button data-tab="viz">4 · Visualisation</button>
  <button data-tab="aqi">5 · AQI Mathematics</button>
  <button data-tab="export">6 · Results &amp; Export</button>
</nav>

<main>

<!-- ============ TAB 1 : DATA LOAD ============ -->
<section id="tab-load" class="tab active">
  <div class="card">
    <h2>1.1 · Load Authorised Government Data</h2>
    <p class="hint">Source: CPCB — Central Pollution Control Board (<code>app.cpcbccr.com</code>) &amp; Gujarat Pollution Control Board (<code>gpcb.gov.in</code>).
       Download city-wise AQI bulletin CSVs (Ahmedabad, Ankleshwar, Gandhinagar, Surat, Vadodara, Vapi, Rajkot…) and drop them here.</p>
    <div class="row">
      <div class="field">
        <label>Upload CPCB / GPCB CSV files (multi-select)</label>
        <input type="file" id="fileInput" accept=".csv,.txt" multiple />
      </div>
      <div class="field">
        <label>&nbsp;</label>
        <button class="btn green" id="btnDemo">⚡ Generate Demo Gujarat Dataset</button>
      </div>
      <div class="field">
        <label>&nbsp;</label>
        <button class="btn ghost" id="btnClear">Clear Data</button>
      </div>
    </div>
    <div class="note">
      <b>Expected columns (auto-detected, case/punctuation insensitive):</b>
      <code>Date</code>, <code>Station</code> / <code>City</code>, <code>PM2.5</code>, <code>PM10</code>,
      <code>NO2</code>, <code>SO2</code>, <code>CO</code>, <code>O3</code>, <code>NH3</code>.
    </div>
    <div id="log-load" class="log"></div>
  </div>

  <div class="card">
    <h2>1.2 · Database Load Checkpoint</h2>
    <p class="hint">Verify row counts, station coverage, date range and column integrity before cleaning.</p>
    <div id="loadKpis" class="kpis"></div>
    <div class="flexbetween">
      <h3 style="margin:0">Raw Data Preview (first 15 records)</h3>
      <span class="badge" id="rawCount">0 rows</span>
    </div>
    <div class="tbl-wrap" id="rawPreview"></div>
  </div>
</section>

<!-- ============ TAB 2 : PREPROCESSING ============ -->
<section id="tab-pre" class="tab">
  <div class="card">
    <h2>2.1 · Data Audit (Before Cleaning)</h2>
    <p class="hint">Null counts, duplicates, data-type sanity and basic distribution checks.</p>
    <div id="auditBefore"></div>
  </div>

  <div class="card">
    <h2>2.2 · Cleaning Configuration</h2>
    <p class="hint">All techniques are applied station-wise and date-sorted.</p>
    <div class="row">
      <div class="field">
        <label>Missing-value strategy</label>
        <select id="optMissing">
          <option value="ffill">Forward / Backward fill (limit 3 days)</option>
          <option value="linear" selected>Linear interpolation (by day)</option>
          <option value="seasonal">Seasonal mean (station × month)</option>
          <option value="knn">KNN imputation (k = 11, z-scored)</option>
          <option value="drop">Drop rows with missing pollutants</option>
        </select>
      </div>
      <div class="field">
        <label>Outlier treatment</label>
        <select id="optOutlier">
          <option value="iqr" selected>IQR capping (Winsorize, 1.5×IQR)</option>
          <option value="zscore">Z-score capping (|z| &gt; 3)</option>
          <option value="none">None</option>
        </select>
      </div>
      <div class="field">
        <label>Duplicates</label>
        <select id="optDedupe">
          <option value="yes" selected>Remove (station + date)</option>
          <option value="no">Keep</option>
        </select>
      </div>
      <div class="field">
        <label>&nbsp;</label>
        <button class="btn" id="btnClean">▶ Run Cleaning Pipeline</button>
      </div>
    </div>
    <div id="log-pre" class="log"></div>
  </div>

  <div class="card">
    <h2>2.3 · Post-Cleaning Verification (Checkpoint)</h2>
    <div id="auditAfter"></div>
  </div>
</section>

<!-- ============ TAB 3 : EDA ============ -->
<section id="tab-eda" class="tab">
  <div class="card">
    <h2>3.1 · Descriptive Statistics</h2>
    <div id="edaStats"></div>
  </div>

  <div class="card">
    <h2>3.2 · Correlation Analysis</h2>
    <p class="hint">Pearson correlation between pollutants. Strong PM2.5–PM10 coupling indicates common combustion/dust sources.</p>
    <div class="grid">
      <div id="edaCorrTbl"></div>
      <div class="chart" id="edaCorrHeat"></div>
    </div>
  </div>

  <div class="card">
    <h2>3.3 · Distribution of Pollutants</h2>
    <p class="hint">Most pollutants are right-skewed — this justifies IQR-based outlier handling rather than z-score removal.</p>
    <div class="grid" id="edaDists"></div>
  </div>

  <div class="card">
    <h2>3.4 · Station × Pollutant Profile</h2>
    <p class="hint">Normalised (0–1) mean concentrations — identifies the most polluted industrial clusters.</p>
    <div class="chart" id="edaStationHeat"></div>
  </div>
</section>

<!-- ============ TAB 4 : VISUALISATION ============ -->
<section id="tab-viz" class="tab">
  <div class="card">
    <div class="flexbetween">
      <h2>4.1 · Temporal Trend (Monthly Means by Station)</h2>
      <div class="field">
        <label>Pollutant</label>
        <select id="vizPollutant"></select>
      </div>
    </div>
    <div class="chart" id="vizTrend" style="height:430px"></div>
  </div>

  <div class="card">
    <h2>4.2 · Seasonal Box Plots</h2>
    <div class="row">
      <div class="field">
        <label>Pollutant</label>
        <select id="vizSeasonPoll"></select>
      </div>
    </div>
    <div class="chart" id="vizSeason" style="height:430px"></div>
  </div>

  <div class="card">
    <h2>4.3 · Station Ranking (Mean Concentration)</h2>
    <div class="chart" id="vizRank" style="height:430px"></div>
  </div>

  <div class="card">
    <h2>4.4 · AQI Category Distribution</h2>
    <p class="hint">Requires Step 5 (AQI calculation) to have been run first.</p>
    <div class="grid">
      <div class="chart" id="vizPie" style="height:380px"></div>
      <div class="chart" id="vizStack" style="height:380px"></div>
    </div>
  </div>
</section>

<!-- ============ TAB 5 : AQI ============ -->
<section id="tab-aqi" class="tab">
  <div class="card">
    <h2>5.1 · CPCB Breakpoint Tables</h2>
    <p class="hint">Piecewise-linear sub-index: I<sub>p</sub> = [ (I<sub>HI</sub>−I<sub>LO</sub>) / (B<sub>HI</sub>−B<sub>LO</sub>) ] × (C<sub>p</sub> − B<sub>LO</sub>) + I<sub>LO</sub></p>
    <div class="tbl-wrap" id="bpTable"></div>
  </div>

  <div class="card">
    <h2>5.2 · AQI Engine</h2>
    <div class="row">
      <div class="field">
        <label>CO units in dataset</label>
        <select id="optCO">
          <option value="auto" selected>Auto-detect</option>
          <option value="mg">mg/m³ (CPCB standard)</option>
          <option value="ug">µg/m³ (convert ÷1000)</option>
        </select>
      </div>
      <div class="field">
        <label>Minimum-pollutant rule</label>
        <select id="optRelax">
          <option value="strict" selected>CPCB strict (≥3 pollutants, PM required)</option>
          <option value="relaxed">Relaxed (any available)</option>
        </select>
      </div>
      <div class="field">
        <label>&nbsp;</label>
        <button class="btn" id="btnAqi">∑ Compute AQI + Maths</button>
      </div>
    </div>
    <div id="log-aqi" class="log"></div>
  </div>

  <div class="card">
    <h2>5.3 · Mathematical Validation (Checkpoint)</h2>
    <div id="aqiValidation"></div>
  </div>

  <div class="card">
    <h2>5.4 · Advanced Mathematical Operations</h2>
    <p class="hint">Applied on top of the base CPCB AQI to strengthen the result.</p>
    <div id="aqiAdvanced"></div>
    <div class="chart" id="vizAqiTrend" style="height:420px"></div>
  </div>
</section>

<!-- ============ TAB 6 : EXPORT ============ -->
<section id="tab-export" class="tab">
  <div class="card">
    <h2>6.1 · Summary Output</h2>
    <div id="exportSummary"></div>
  </div>
  <div class="card">
    <h2>6.2 · Download</h2>
    <div class="row">
      <button class="btn" id="dlProcessed">⬇ Processed + AQI dataset (CSV)</button>
      <button class="btn ghost" id="dlSummary">⬇ Station summary (CSV)</button>
      <button class="btn ghost" id="dlMonthly">⬇ Monthly AQI matrix (CSV)</button>
    </div>
  </div>
</section>

</main>

<script>
/* ==========================================================================
   GLOBAL STATE
   ========================================================================== */
const POLLUTANTS = ['pm25','pm10','no2','so2','co','o3','nh3'];
const LABEL = {pm25:'PM2.5', pm10:'PM10', no2:'NO2', so2:'SO2', co:'CO', o3:'O3', nh3:'NH3'};
const UNIT  = {pm25:'µg/m³', pm10:'µg/m³', no2:'µg/m³', so2:'µg/m³', co:'mg/m³', o3:'µg/m³', nh3:'µg/m³'};

const state = {
  raw: [],        // parsed raw records
  clean: [],      // cleaned records
  stations: [],
  aqiDone: false
};

/* ==========================================================================
   SMALL HELPERS
   ========================================================================== */
function $(id){ return document.getElementById(id); }

function logTo(elId, msg, type){
  const el = $(elId);
  if (!el) return;
  const d = document.createElement('div');
  d.className = 'log-' + (type || 'info');
  d.textContent = msg;
  el.appendChild(d);
  el.scrollTop = el.scrollHeight;
}
function clearLog(elId){ const e = $(elId); if (e) e.innerHTML = ''; }

function mean(a){ if(!a.length) return NaN; let s=0; for(const v of a) s+=v; return s/a.length; }
function std(a){
  if(a.length<2) return 0;
  const m = mean(a); let s=0;
  for(const v of a) s += (v-m)*(v-m);
  return Math.sqrt(s/(a.length-1));
}
function quantile(sorted, q){
  if(!sorted.length) return NaN;
  const pos = (sorted.length-1)*q;
  const base = Math.floor(pos);
  const rest = pos - base;
  if(sorted[base+1] !== undefined) return sorted[base] + rest*(sorted[base+1]-sorted[base]);
  return sorted[base];
}
function pearson(x, y){
  const n = Math.min(x.length, y.length);
  if(n < 3) return NaN;
  const mx = mean(x.slice(0,n)), my = mean(y.slice(0,n));
  let num=0, dx=0, dy=0;
  for(let i=0;i<n;i++){
    const a = x[i]-mx, b = y[i]-my;
    num += a*b; dx += a*a; dy += b*b;
  }
  if(dx===0 || dy===0) return NaN;
  return num/Math.sqrt(dx*dy);
}
function groupBy(arr, keyFn){
  const m = {};
  for(const r of arr){
    const k = keyFn(r);
    (m[k] = m[k] || []).push(r);
  }
  return m;
}
function fmt(v, d){
  if(v===null || v===undefined || !isFinite(v)) return '—';
  return Number(v).toFixed(d===undefined?2:d);
}
function dateKey(d){ return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function monthKey(d){ return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'); }
function seasonOf(m){
  if(m===12 || m===1 || m===2) return 'Winter';
  if(m>=3 && m<=5) return 'Summer';
  if(m>=6 && m<=9) return 'Monsoon';
  return 'Post-Monsoon';
}

/* ==========================================================================
   TAB NAVIGATION
   ========================================================================== */
document.querySelectorAll('#nav button').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('#nav button').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('section.tab').forEach(s=>s.classList.remove('active'));
    btn.classList.add('active');
    $('tab-' + btn.dataset.tab).classList.add('active');
    setTimeout(()=>{ window.dispatchEvent(new Event('resize')); }, 60);
  });
});

/* ==========================================================================
   PARSING UTILITIES
   ========================================================================== */
function normKey(s){ return String(s).toLowerCase().replace(/[^a-z0-9]/g,''); }

const ALIASES = {
  date:    ['date','datetime','datetimestamp','timestamp','aqibulletindate','dateofbulletin',
            'samplingdate','fromdate','todate','dateofsampling','monitoringdate'],
  station: ['station','stationname','city','location','monitoringstation','site',
            'monitoringsite','stationid','nameofstation','area'],
  pm25:    ['pm25','pm2p5','pm25ugm3','pm25ugm3','rspm25','finepm'],
  pm10:    ['pm10','pm10ugm3','rspm','spm10'],
  no2:     ['no2','nitrogendioxide','nitrogen dioxide'],
  so2:     ['so2','sulphurdioxide','sulfurdioxide','sulphur dioxide'],
  co:      ['co','carbonmonoxide','carbon monoxide'],
  o3:      ['o3','ozone'],
  nh3:     ['nh3','ammonia']
};

function buildColumnMap(headers){
  const map = {};
  for(const h of headers){
    const k = normKey(h);
    for(const field in ALIASES){
      if(!(field in map) && ALIASES[field].indexOf(k) !== -1){
        map[field] = h;
      }
    }
  }
  return map;
}

function parseDate(v){
  if(v instanceof Date) return isNaN(v) ? null : v;
  if(v===null || v===undefined) return null;
  const s = String(v).trim();
  if(!s) return null;

  // YYYY-MM-DD or YYYY/MM/DD
  let m = s.match(/^(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})/);
  if(m) return new Date(+m[1], +m[2]-1, +m[3]);

  // DD-MM-YYYY or DD/MM/YYYY (Indian convention)
  m = s.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{2,4})/);
  if(m){
    let a = +m[1], b = +m[2], y = +m[3];
    if(y < 100) y += 2000;
    let d, mo;
    if(a > 12 && b <= 12){ d = a; mo = b; }
    else if(b > 12 && a <= 12){ d = b; mo = a; }
    else { d = a; mo = b; }   // default DD-MM
    return new Date(y, mo-1, d);
  }

  const d2 = new Date(s);
  return isNaN(d2.getTime()) ? null : d2;
}

function toNum(v){
  if(v===null || v===undefined) return null;
  if(typeof v === 'number') return isFinite(v) ? v : null;
  const s = String(v).trim();
  if(!s) return null;
  if(/^(na|n\/a|nan|null|nil|none|-|--|---|\.)$/i.test(s)) return null;
  const n = Number(s.replace(/,/g,'').replace(/[^\d.eE+-]/g,''));
  return isFinite(n) ? n : null;
}

/* ==========================================================================
   DATA INGESTION
   ========================================================================== */
function ingestRows(rawRows, sourceName){
  if(!rawRows || !rawRows.length) return 0;
  const headers = Object.keys(rawRows[0]);
  const map = buildColumnMap(headers);

  if(!map.date){
    logTo('log-load', '✗ ' + sourceName + ' — no date column found. Headers: ' + headers.join(' | '), 'err');
    return 0;
  }
  logTo('log-load', '↳ ' + sourceName + ' — column map: ' +
        Object.keys(map).map(f => f + '→"' + map[f] + '"').join(', '), 'info');

  let added = 0;
  for(const r of rawRows){
    const date = parseDate(r[map.date]);
    if(!date) continue;
    let station = map.station ? String(r[map.station] || '').trim() : '';
    if(!station) station = sourceName.replace(/\.csv$/i,'').replace(/_AQIBulletins$/i,'');
    if(!station) station = 'Unknown';

    const obj = { date: date, station: station, _source: sourceName };
    for(const p of POLLUTANTS){
      obj[p] = map[p] ? toNum(r[map[p]]) : null;
    }
    state.raw.push(obj);
    added++;
  }
  return added;
}

function handleFiles(files){
  let pending = files.length;
  if(!pending) return;
  Array.from(files).forEach(file=>{
    Papa.parse(file, {
      header: true,
      skipEmptyLines: 'greedy',
      dynamicTyping: false,
      complete: function(res){
        const n = ingestRows(res.data, file.name);
        logTo('log-load', '✓ ' + file.name + ' — ingested ' + n + ' valid rows.', n ? 'ok' : 'warn');
        if(--pending === 0) refreshLoadTab();
      },
      error: function(err){
        logTo('log-load', '✗ ' + file.name + ' — parse error: ' + err.message, 'err');
        if(--pending === 0) refreshLoadTab();
      }
    });
  });
}

/* ==========================================================================
   DEMO DATA GENERATOR (realistic Gujarat patterns)
   ========================================================================== */
function randn(){
  let u=0, v=0;
  while(u===0) u = Math.random();
  while(v===0) v = Math.random();
  return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);
}

function generateDemoData(){
  const stations = [
    { name:'Ahmedabad',   f:1.25 },
    { name:'Ankleshwar',  f:1.48 },
    { name:'Vapi',        f:1.42 },
    { name:'Surat',       f:1.12 },
    { name:'Vadodara',    f:1.18 },
    { name:'Rajkot',      f:0.90 },
    { name:'Gandhinagar', f:0.96 }
  ];
  const base = { pm25:56, pm10:112, no2:38, so2:14, co:1.05, o3:44, nh3:27 };
  const start = new Date(2021,0,1);
  const end   = new Date(2023,11,31);
  const out = [];

  for(const st of stations){
    for(let d = new Date(start); d <= end; d.setDate(d.getDate()+1)){
      const date = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      const doy = Math.floor((date - new Date(date.getFullYear(),0,0)) / 86400000);
      const month = date.getMonth()+1;

      const winter  = 1 + 0.60*Math.cos(2*Math.PI*(doy-20)/365);
      const summer  = 1 + 0.30*Math.cos(2*Math.PI*(doy-120)/365);
      const washout = (month>=6 && month<=9) ? 0.52 : 1;
      const postMon = (month>=10 && month<=11) ? 1.14 : 1;
      const trend   = 1 - 0.055*((date.getFullYear()-2021) + date.getMonth()/12); // gradual improvement

      const weekend = (date.getDay()===0 || date.getDay()===6) ? 0.88 : 1;

      const rec = { date: date, station: st.name, _source: 'demo' };

      for(const p of POLLUTANTS){
        let sf;
        if(p === 'o3')       sf = summer;
        else if(p === 'co')  sf = winter * washout;
        else if(p === 'nh3') sf = (1 + 0.28*Math.cos(2*Math.PI*(doy-150)/365)) * washout;
        else                 sf = winter * washout * postMon;

        let v = base[p] * st.f * sf * trend * weekend;
        v *= (1 + 0.22*randn());

        // inject occasional pollution episodes (outliers)
        if(Math.random() < 0.018) v *= (2.0 + Math.random()*1.6);

        if(v < 0.01) v = 0.01;
        rec[p] = Math.round(v*100)/100;
      }

      // inject realistic missingness (~4% per pollutant, occasional runs)
      for(const p of POLLUTANTS){
        if(Math.random() < 0.04) rec[p] = null;
      }
      if(Math.random() < 0.012){
        const p = POLLUTANTS[Math.floor(Math.random()*POLLUTANTS.length)];
        for(let k=0;k<4;k++){
          const dd = new Date(date); dd.setDate(dd.getDate()+k);
          out.push(Object.assign({}, rec, { date: dd, station: st.name, [p]: null }));
        }
      }

      out.push(rec);
    }
  }

  // inject duplicate records (to exercise dedupe)
  for(let i=0;i<40;i++){
    const src = out[Math.floor(Math.random()*out.length)];
    out.push(Object.assign({}, src));
  }

  state.raw = state.raw.concat(out);
  logTo('log-load', '✓ Demo dataset generated: ' + out.length +
        ' rows × 7 Gujarat stations (2021–2023), with injected gaps, outliers and duplicates.', 'ok');
  refreshLoadTab();
}

