$('dlSummary').addEventListener('click', function(){
  if(!state.stationStats){ alert('Run the AQI step first (Tab 5).'); return; }
  downloadCSV('gujarat_station_summary.csv', state.stationStats,
    ['station','n','meanAqi','maxAqi','minAqi','stdAqi','p95','exceedPct']);
});
$('dlMonthly').addEventListener('click', function(){
  const data = state.clean.filter(r => r.aqi !== null && isFinite(r.aqi));
  if(!data.length){ alert('Run the AQI step first (Tab 5).'); return; }
  const buckets = {};
  for(const r of data){
    const k = r.station + '|' + monthKey(r.date);
    (buckets[k] = buckets[k] || []).push(r.aqi);
  }
  const out = Object.keys(buckets).sort().map(k=>{
    const parts = k.split('|');
    return { station: parts[0], month: parts[1], meanAqi: Math.round(mean(buckets[k])*10)/10, n: buckets[k].length };
  });
  downloadCSV('gujarat_monthly_aqi.csv', out, ['station','month','meanAqi','n']);
});

