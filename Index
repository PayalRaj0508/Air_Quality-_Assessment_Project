/* ---- main AQI run ---- */
function runAqi(){
  clearLog('log-aqi');
  if(!state.clean.length){
    logTo('log-aqi', '✗ No cleaned data. Run the preprocessing pipeline (Tab 2) first.', 'err');
    return;
  }
  const data = state.clean;
  const coOpt = $('optCO').value;
  const relaxed = $('optRelax').value === 'relaxed';

  logTo('log-aqi', '▶ Computing CPCB sub-indices and AQI…', 'info');

  /* --- CO unit handling --- */
  let coScale = 1;
  if(coOpt === 'ug'){ coScale = 0.001; }
  else if(coOpt === 'auto'){
    const vals = data.map(r => r.co).filter(v => v !== null && isFinite(v)).sort((a,b)=>a-b);
    const med = vals.length ? quantile(vals, 0.5) : 0;
    if(med > 20){ coScale = 0.001; logTo('log-aqi', '   Auto-detect: median CO = ' + fmt(med) +
      ' → dataset appears to be in µg/m³. Converting to mg/m³ (÷1000).', 'warn'); }
    else { logTo('log-aqi', '   Auto-detect: median CO = ' + fmt(med) + ' → assuming mg/m³ (CPCB standard).', 'ok'); }
  }
  if(coScale !== 1){
    for(const r of data) if(r.co !== null && isFinite(r.co)) r.co = r.co * coScale;
  }

  /* --- per-row AQI --- */
  let valid = 0, invalid = 0;
  const primaryCount = {};
  for(const r of data){
    const res = computeRowAqi(r, { relaxed: relaxed });
    r.aqi = res.aqi;
    r.primaryPollutant = res.primary;
    r.aqiCategory = aqiCategory(res.aqi);
    for(const p of POLLUTANTS){
      r['si_' + p] = res.subs[p] !== undefined ? res.subs[p] : null;
    }
    if(res.aqi === null){ invalid++; }
    else {
      valid++;
      primaryCount[res.primary] = (primaryCount[res.primary] || 0) + 1;
    }
  }
  logTo('log-aqi', '① Sub-index calculation complete. Valid AQI rows: ' + valid.toLocaleString() +
        ' / ' + data.length.toLocaleString() + ' (' + (valid/data.length*100).toFixed(1) + '%).', 'ok');
  if(invalid) logTo('log-aqi', '   ' + invalid.toLocaleString() +
        ' rows failed the CPCB minimum-pollutant rule (need ≥3 pollutants incl. PM2.5 or PM10).', 'warn');

  /* --- advanced maths --- */
  computeAdvancedMaths(data);

  /* --- validation --- */
  validateAqi(data);

  /* --- visual validation --- */
  drawAqiCharts();
  state.aqiDone = true;
  logTo('log-aqi', '✔ AQI pipeline finished. Scroll down for validation + advanced metrics.', 'ok');
}

/* ---- weighted composite + smoothing + standardisation ---- */
const HEALTH_WEIGHTS = { pm25:1.0, pm10:0.7, no2:0.5, so2:0.4, co:0.3, o3:0.6, nh3:0.2 };

function computeAdvancedMaths(data){
  /* 1. weighted composite index */
  for(const r of data){
    let wsum = 0, wtotal = 0;
    for(const p of POLLUTANTS){
      const si = r['si_' + p];
      if(si === null || si === undefined) continue;
      wsum += si * HEALTH_WEIGHTS[p];
      wtotal += HEALTH_WEIGHTS[p];
    }
    r.weightedAqi = wtotal > 0 ? Math.round(wsum / wtotal) : null;
  }

  /* 2. rolling 7-day mean + EWMA per station */
  const byStation = groupBy(data, r => r.station);
  const alpha = 2/(7+1);
  for(const st in byStation){
    const rows = byStation[st].slice().sort((a,b)=> a.date - b.date);
    const buf = [];
    let ewma = null;
    for(const r of rows){
      if(r.aqi !== null && isFinite(r.aqi)){
        buf.push(r.aqi);
        if(buf.length > 7) buf.shift();
        r.aqi7day = buf.length >= 3 ? Math.round(mean(buf)) : null;
        ewma = (ewma === null) ? r.aqi : (alpha * r.aqi + (1 - alpha) * ewma);
        r.aqiEwma = Math.round(ewma);
      } else {
        r.aqi7day = null; r.aqiEwma = ewma === null ? null : Math.round(ewma);
      }
    }
  }

  /* 3. z-score + percentile per station */
  for(const st in byStation){
    const rows = byStation[st];
    const vals = rows.map(r=>r.aqi).filter(v=>v!==null && isFinite(v));
    if(!vals.length) continue;
    const m = mean(vals), s = std(vals);
    const sorted = vals.slice().sort((a,b)=>a-b);
    for(const r of rows){
      if(r.aqi === null || !isFinite(r.aqi)){ r.aqiZ = null; r.aqiPct = null; continue; }
      r.aqiZ = s > 0 ? (r.aqi - m)/s : 0;
      // percentile rank
      let lo = 0, hi = sorted.length;
      while(lo < hi){ const mid = (lo+hi)>>1; if(sorted[mid] < r.aqi) lo = mid+1; else hi = mid; }
      r.aqiPct = (lo / sorted.length) * 100;
    }
  }

  /* 4. station statistics */
  const stats = [];
  for(const st in byStation){
    const rows = byStation[st];
    const vals = rows.map(r=>r.aqi).filter(v=>v!==null && isFinite(v));
    if(!vals.length) continue;
    const severe = rows.filter(r => r.aqiCategory === 'Severe' || r.aqiCategory === 'Very Poor').length;
    stats.push({
      station: st,
      n: vals.length,
      meanAqi: mean(vals),
      maxAqi: Math.max.apply(null, vals),
      minAqi: Math.min.apply(null, vals),
      stdAqi: std(vals),
      p95: quantile(vals.slice().sort((a,b)=>a-b), 0.95),
      exceedPct: rows.length ? (severe/rows.length*100) : 0
    });
  }
  stats.sort((a,b)=> b.meanAqi - a.meanAqi);
  state.stationStats = stats;
}

function validateAqi(data){
  const pairs = data.filter(r => r.aqi !== null && r.pm25 !== null);
  const rPM25 = pearson(pairs.map(r=>r.pm25), pairs.map(r=>r.aqi));
  const pairs10 = data.filter(r => r.aqi !== null && r.pm10 !== null);
  const rPM10 = pearson(pairs10.map(r=>r.pm10), pairs10.map(r=>r.aqi));

  // monotonicity test on the sub-index function itself
  const monotone = [];
  for(let c=0; c<=300; c+=10){
    monotone.push([c, subIndex(c,'pm25')]);
  }
  let monoOk = true;
  for(let i=1;i<monotone.length;i++) if(monotone[i][1] < monotone[i-1][1]) monoOk = false;

  // boundary checks
  const boundaries = [
    ['PM2.5 = 30 → 50',  subIndex(30,'pm25'), 50],
    ['PM2.5 = 60 → 100', subIndex(60,'pm25'), 100],
    ['PM2.5 = 90 → 200', subIndex(90,'pm25'), 200],
    ['PM2.5 = 120 → 300',subIndex(120,'pm25'),300],
    ['PM10 = 100 → 100', subIndex(100,'pm10'),100],
    ['PM10 = 250 → 200', subIndex(250,'pm10'),200],
    ['NO2 = 80 → 100',   subIndex(80,'no2'),  100]
  ];

  const aqiVals = data.map(r=>r.aqi).filter(v=>v!==null && isFinite(v));
  const inRange = aqiVals.every(v => v >= 0 && v <= 500);

  let h = '<div class="kpis">' +
    kpi(fmt(rPM25,4), 'Corr(PM2.5, AQI)  → target &gt; 0.95', rPM25 > 0.95 ? 'ok' : 'warn') +
    kpi(fmt(rPM10,4), 'Corr(PM10, AQI)') +
    kpi(monoOk ? 'PASS' : 'FAIL', 'Sub-index monotonicity') +
    kpi(inRange ? 'PASS' : 'FAIL', 'AQI within 0–500') +
    kpi(aqiVals.length.toLocaleString(), 'Valid AQI records') +
    '</div>';

  h += '<div class="tbl-wrap" style="margin-top:12px"><table><thead><tr>' +
       '<th>Boundary check</th><th>Computed</th><th>Expected</th><th>Status</th></tr></thead><tbody>';
  for(const b of boundaries){
    const ok = b[1] === b[2];
    h += '<tr><td>'+b[0]+'</td><td>'+b[1]+'</td><td>'+b[2]+'</td>' +
         '<td style="color:'+(ok?'#4ade80':'#f87171')+'">'+(ok?'PASS':'FAIL')+'</td></tr>';
  }
  h += '</tbody></table></div>';

  h += '<h3 style="margin-top:18px">Station-level AQI Statistics</h3>';
  h += '<div class="tbl-wrap"><table><thead><tr><th>Station</th><th>N</th><th>Mean AQI</th>' +
       '<th>Max AQI</th><th>Min AQI</th><th>SD</th><th>95th pct</th><th>% days Very Poor/Severe</th></tr></thead><tbody>';
  for(const s of state.stationStats){
    h += '<tr><td><b>'+s.station+'</b></td><td>'+s.n+'</td><td>'+fmt(s.meanAqi,1)+'</td>' +
         '<td>'+fmt(s.maxAqi,0)+'</td><td>'+fmt(s.minAqi,0)+'</td><td>'+fmt(s.stdAqi,1)+'</td>' +
         '<td>'+fmt(s.p95,1)+'</td><td>'+fmt(s.exceedPct,1)+'%</td></tr>';
  }
  h += '</tbody></table></div>';
  $('aqiValidation').innerHTML = h;

  /* advanced metrics panel */
  const withAqi = data.filter(r => r.aqi !== null && isFinite(r.aqi));
  const meanBase = mean(withAqi.map(r=>r.aqi));
  const meanW    = mean(withAqi.map(r=>r.weightedAqi).filter(v=>v!==null));
  const mean7    = mean(withAqi.map(r=>r.aqi7day).filter(v=>v!==null && isFinite(v)));
  const meanEwma = mean(withAqi.map(r=>r.aqiEwma).filter(v=>v!==null && isFinite(v)));

  let ah = '<div class="tbl-wrap"><table><thead><tr><th>Metric</th><th>Formula</th>' +
           '<th>Mean value</th><th>Purpose</th></tr></thead><tbody>' +
    '<tr><td><b>CPCB AQI</b></td><td>max(sub-indices)</td><td>'+fmt(meanBase,1)+'</td>' +
      '<td>Regulatory index as defined by CPCB</td></tr>' +
    '<tr><td><b>Weighted composite</b></td><td>Σ(w<sub>p</sub>·SI<sub>p</sub>) / Σw<sub>p</sub></td>' +
      '<td>'+fmt(meanW,1)+'</td><td>Health-impact-weighted blend of all pollutants</td></tr>' +
    '<tr><td><b>7-day rolling mean</b></td><td>mean(AQI<sub>t−6…t</sub>)</td><td>'+fmt(mean7,1)+'</td>' +
      '<td>Removes day-to-day noise, exposes trend</td></tr>' +
    '<tr><td><b>EWMA (span 7)</b></td><td>α·AQI<sub>t</sub> + (1−α)·EWMA<sub>t−1</sub>, α=0.25</td>' +
      '<td>'+fmt(meanEwma,1)+'</td><td>Recency-weighted trend indicator</td></tr>' +
    '<tr><td><b>Z-score</b></td><td>(AQI − μ<sub>station</sub>) / σ<sub>station</sub></td>' +
      '<td>0.00 (by construction)</td><td>Cross-station comparability</td></tr>' +
    '<tr><td><b>Percentile rank</b></td><td>rank(AQI) / N × 100</td>' +
      '<td>50.0 (median)</td><td>Relative severity within station</td></tr>' +
    '</tbody></table></div>';

  ah += '<div class="note"><b>Note on CO:</b> CPCB breakpoints for CO are defined in <b>mg/m³</b>, ' +
        'while all other pollutants use µg/m³. If your dataset stores CO in µg/m³, the auto-detect ' +
        'converts it (÷1000) before sub-index calculation.</div>';

  $('aqiAdvanced').innerHTML = ah;
}

function kpi(value, label, status){
  const color = status === 'ok' ? '#4ade80' : (status === 'warn' ? '#fbbf24' : '#38bdf8');
  return '<div class="kpi"><div class="v" style="color:'+color+'">'+value+'</div>' +
         '<div class="l">'+label+'</div></div>';
}

/* ---- AQI visualisations ---- */
function drawAqiCharts(){
  const data = state.clean.filter(r => r.aqi !== null && isFinite(r.aqi));
  if(!data.length) return;

  /* pie */
  const counts = {};
  for(const c of AQI_CATS) counts[c.name] = 0;
  for(const r of data) if(r.aqiCategory) counts[r.aqiCategory]++;
  const order = AQI_CATS.map(c=>c.name).filter(n => counts[n] > 0);
  const colors = { 'Good':'#00b050', 'Satisfactory':'#92d050', 'Moderate':'#ffff00',
                   'Poor':'#ff9900', 'Very Poor':'#ff0000', 'Severe':'#c00000' };

  Plotly.newPlot('vizPie', [{
    labels: order,
    values: order.map(n => counts[n]),
    type: 'pie',
    marker: { colors: order.map(n => colors[n]), line: { color:'#1b2b3d', width: 2 } },
    textinfo: 'label+percent',
    textfont: { size: 11, color: '#0b1a24' },
    hole: 0.38
  }], Object.assign(plotLayout('AQI category distribution'), {
    showlegend: false, margin: { l: 10, r: 10, t: 40, b: 10 }
  }));

  /* stacked bar by station */
  const stations = [...new Set(data.map(r=>r.station))].sort();
  const traces = AQI_CATS.map(c => ({
    x: stations,
    y: stations.map(st => {
      const rows = data.filter(r => r.station === st);
      return rows.length ? rows.filter(r => r.aqiCategory === c.name).length / rows.length * 100 : 0;
    }),
    name: c.name,
    type: 'bar',
    marker: { color: colors[c.name] }
  }));

  Plotly.newPlot('vizStack', traces, Object.assign(plotLayout('AQI category share by station (%)'), {
    barmode: 'stack',
    xaxis: { gridcolor:'#22303f', color:'#93a6b8', tickangle: -30 },
    yaxis: { title: { text: '% of days', font:{ size:11, color:'#93a6b8'} }, gridcolor:'#22303f', color:'#93a6b8', range:[0,100] },
    legend: { orientation: 'h', y: -0.25, font:{ size:10 } }
  }));

  /* AQI trend with rolling average */
  const stationsAll = [...new Set(data.map(r=>r.station))].sort();
  const palette = ['#38bdf8','#f472b6','#4ade80','#fbbf24','#a78bfa','#fb923c','#22d3ee','#f87171','#34d399','#e879f9'];
  const trendTraces = [];
  stationsAll.forEach((st, i)=>{
    const rows = data.filter(r => r.station === st).sort((a,b)=> a.date - b.date);
    trendTraces.push({
      x: rows.map(r => dateKey(r.date)),
      y: rows.map(r => r.aqi7day),
      type: 'scatter', mode: 'lines',
      name: st + ' (7-day)',
      line: { color: palette[i % palette.length], width: 2 }
    });
  });

  Plotly.newPlot('vizAqiTrend', trendTraces, Object.assign(plotLayout('7-day rolling mean AQI by station'), {
    xaxis: { title: { text:'Date', font:{size:11,color:'#93a6b8'} }, gridcolor:'#22303f', color:'#93a6b8' },
    yaxis: { title: { text:'AQI (7-day rolling mean)', font:{size:11,color:'#93a6b8'} }, gridcolor:'#22303f', color:'#93a6b8' },
    shapes: [
      { type:'line', xref:'paper', x0:0, x1:1, y0:100, y1:100, line:{ color:'#4ade80', width:1, dash:'dot' } },
      { type:'line', xref:'paper', x0:0, x1:1, y0:200, y1:200, line:{ color:'#fbbf24', width:1, dash:'dot' } },
      { type:'line', xref:'paper', x0:0, x1:1, y0:300, y1:300, line:{ color:'#fb923c', width:1, dash:'dot' } },
      { type:'line', xref:'paper', x0:0, x1:1, y0:400, y1:400, line:{ color:'#f87171', width:1, dash:'dot' } }
    ],
    annotations: [
      { xref:'paper', x:1.005, y:100, text:'Satisfactory', showarrow:false, font:{size:9,color:'#4ade80'} },
      { xref:'paper', x:1.005, y:200, text:'Moderate', showarrow:false, font:{size:9,color:'#fbbf24'} },
      { xref:'paper', x:1.005, y:300, text:'Poor', showarrow:false, font:{size:9,color:'#fb923c'} },
      { xref:'paper', x:1.005, y:400, text:'Very Poor', showarrow:false, font:{size:9,color:'#f87171'} }
    ]
  }), { responsive: true });
}

/* ==========================================================================
