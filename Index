    ['Date range', dmin ? dateKey(dmin)+' → '+dateKey(dmax) : '—'],
    ['Complete rows', complete.toLocaleString() + ' (' + (rows.length ? (complete/rows.length*100).toFixed(1) : 0) + '%)']
  ].map(k => '<div class="kpi"><div class="v">'+k[1]+'</div><div class="l">'+k[0]+'</div></div>').join('');

